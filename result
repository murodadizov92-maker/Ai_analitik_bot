"""«Резултат»: oy boshidan shu vaqtgacha har bir agent (va OFIS) bo'yicha reja, savdo (yuk chiqqan) va tushgan pul."""
import html

import analysis
import report
from report import short, status


def mln(x):
    return f"{x / 1e6:.0f}" if abs(x) >= 1e9 else f"{x / 1e6:.1f}"


async def collect_pays(client, first, day):
    pays = await client.paginate(
        "getPayment", {"filter": {"transactionType": 3, "period": {"date": {"from": str(first), "to": str(day)}}}}, "payment")
    out = {}
    for p in pays:
        aid = (p.get("agent") or {}).get("SD_id")
        out[aid] = out.get(aid, 0.0) + float(p.get("amount") or 0)
    return out


async def collect_ship(client, first, day, statuses, date_filter):
    """Oy boshidan chiqqan yuk (yuborilgan/yetkazilgan/yopilgan buyurtmalar): {agent_id: summa}"""
    orders = await client.paginate(
        "getOrder", {"filter": {"agent": "all", "status": statuses,
                                "period": {date_filter: {"from": str(first), "to": str(day)}}}}, "order")
    out = {}
    for o in orders:
        aid = (o.get("agent") or {}).get("SD_id")
        out[aid] = out.get(aid, 0.0) + float(o.get("totalSummaAfterDiscount") or o.get("totalSumma") or 0)
    return out


def bar(p, width=10):
    n = max(0, min(width, int(round(p * width))))
    return "▰" * n + "▱" * (width - n)


def pct_s(x):
    return f"{x * 100:.0f}%"


def card(aid, a, ship, pays):
    """Bitta agent kartochkasi: oddiy so'zlar bilan."""
    e = lambda x: html.escape(str(x), quote=False)
    z, y, p = a["mtd"], ship.get(aid, 0), pays.get(aid, 0)
    L = [f"<b>{e(a['name'])}</b>" + (f" · reja {short(a['plan'])}" if a["plan"] else " · reja belgilanmagan")]
    if a["plan"]:
        L.append(f"Zakas: <b>{short(z)}</b> ({pct_s(z / a['plan'])})  {bar(z / a['plan'])}")
    else:
        L.append(f"Zakas: <b>{short(z)}</b>")
    L.append(f"Yuk chiqqan: {short(y)} · Pul tushgan: {short(p)}")
    if a["plan"]:
        gap = a["plan"] - a["forecast"]
        L.append(f"Oy oxirigacha prognoz: <b>{short(a['forecast'])}</b> ({pct_s(a['pct'])})"
                 + (f", kamomad ~{short(gap)}" if gap > 0 else ""))
        if a["pct"] < 1:
            L.append(f"Reja uchun kuniga <b>{short(a['need'])}</b> kerak (hozir {short(a['pace'])})")
        else:
            L.append("Tempni saqlasa, reja bajariladi")
    if z and y / z < 0.9:
        L.append(f"⚠️ Yuk orqada: zakasning {pct_s(y / z)} i chiqqan")
    if y and p / y < 0.5:
        L.append(f"⚠️ Pul kam tushgan: chiqqan yukning {pct_s(p / y)} i")
    elif y and p > y * 1.2:
        L.append("💵 Pul yukdan ko'p: oldingi qarzlar ham yig'ilgan")
    return "\n".join(L)


def build(month, pays, ship, day, title):
    """month: analysis.month_forecast natijasi; pays/ship: {agent_id: summa}. Qaytaradi: [xabar matnlari]"""
    e = lambda x: html.escape(str(x), quote=False)
    t = month["team"]
    ag = sorted(month["agents"].items(), key=lambda kv: -(kv[1]["plan"] or kv[1]["mtd"]))
    tot_plan = sum(a["plan"] for _, a in ag)
    tot_z = sum(a["mtd"] for _, a in ag)
    tot_y = sum(ship.get(aid, 0) for aid, _ in ag)
    tot_p = sum(pays.get(aid, 0) for aid, _ in ag)

    parts = [f"📊 <b>{e(title)} — oy natijasi</b>\n"
             f"📅 {day.replace(day=1):%d.%m} – {day:%d.%m.%Y} · {t['worked']} ish kuni o'tdi, {t['rem']} qoldi"]

    tot = ["🏁 <b>UMUMIY</b>"]
    if tot_plan:
        tot.append(f"Reja: <b>{short(tot_plan)}</b>")
        tot.append(f"Zakas (olingan buyurtmalar): <b>{short(tot_z)}</b> — {pct_s(tot_z / tot_plan)}  {bar(tot_z / tot_plan)}")
    else:
        tot.append(f"Zakas (olingan buyurtmalar): <b>{short(tot_z)}</b>")
    tot.append(f"Yuk chiqqan (yetkazishga): <b>{short(tot_y)}</b>")
    tot.append(f"Pul tushgan: <b>{short(tot_p)}</b>")
    if t["plan"]:
        tot.append(f"📈 Oy oxirigacha prognoz: <b>{short(t['forecast'])}</b> ({pct_s(t['pct'])}) {status(t['pct'])}")
    parts.append("\n".join(tot))

    groups = {"red": [], "yellow": [], "green": [], "none": []}
    for aid, a in ag:
        if not a["plan"]:
            groups["none"].append((aid, a))
        elif a["pct"] >= 1:
            groups["green"].append((aid, a))
        elif a["pct"] >= 0.85:
            groups["yellow"].append((aid, a))
        else:
            groups["red"].append((aid, a))
    titles = {"red": "🔴 <b>XAVF — tezkor chora kerak</b>", "yellow": "🟡 <b>DIQQAT — ozgina yetmayapti</b>",
              "green": "🟢 <b>YAXSHI — reja bajarilmoqda</b>", "none": "⚪ <b>REJASIZ</b>"}
    for k in ("red", "yellow", "green", "none"):
        if groups[k]:
            parts.append(titles[k] + "\n\n" + "\n\n".join(card(aid, a, ship, pays) for aid, a in groups[k]))

    if t["plan"]:
        worst = max(((a["plan"] - a["forecast"], a["name"]) for _, a in ag if a["plan"]), default=(0, ""), key=lambda x: x[0])
        if worst[0] > 0:
            parts.append(f"🎯 <b>Xulosa:</b> eng katta kamomad — <b>{e(worst[1])}</b> (~{short(worst[0])}). "
                         f"Rejaga yetish uchun jami kuniga <b>{short(t['need_plan'])}</b> kerak, hozir {short(t['pace'])}.")
        else:
            parts.append("🎯 <b>Xulosa:</b> hozirgi sur'at bilan reja bajariladi. Sur'atni tushirmang.")
    else:
        parts.append("ℹ️ Bu filial uchun oylik agent rejalari kiritilmagan, shuning uchun reja foizi va prognoz ko'rsatilmadi.")

    out, cur = [], ""
    for blk in "\n\n".join(parts).split("\n\n"):
        if cur and len(cur) + len(blk) + 2 > 3900:
            out.append(cur)
            cur = ""
        cur += ("\n\n" if cur else "") + blk
    if cur:
        out.append(cur)
    return out
